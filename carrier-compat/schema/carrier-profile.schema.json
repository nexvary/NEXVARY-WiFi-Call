{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXVARY Carrier Profile",
  "type": "object",
  "required": [
    "id",
    "mcc",
    "mnc",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "mcc": {
      "type": "string",
      "pattern": "^[0-9]{3}$"
    },
    "mnc": {
      "type": "string",
      "pattern": "^[0-9]{2,3}$"
    },
    "epdg": {
      "type": "object",
      "properties": {
        "discovery": {
          "enum": [
            "3gpp-derived",
            "configured",
            "unknown"
          ]
        },
        "hostname": {
          "type": "string"
        }
      }
    },
    "entitlement": {
      "enum": [
        "unknown",
        "none-observed",
        "required"
      ]
    },
    "evidence": {
      "enum": [
        "UNKNOWN",
        "DISCOVERED",
        "EPDG_REACHABLE",
        "SWU_AUTHENTICATED",
        "IMS_REGISTERED",
        "OUTBOUND_VOICE_VERIFIED",
        "INBOUND_VOICE_VERIFIED",
        "SMS_VERIFIED",
        "PRODUCTION_CANDIDATE"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}