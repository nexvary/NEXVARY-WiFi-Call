    <string name="gateway_title">Associer la passerelle</string>
    <string name="gateway_intro">Associez votre passerelle HTTPS pour envoyer un résumé de diagnostic limité. Cette opération n’authentifie pas la SIM et n’active pas les appels.</string>
    <string name="gateway_url">URL HTTPS de la passerelle</string>
    <string name="gateway_code">Code d’association</string>
    <string name="gateway_pair">Associer la passerelle</string>
