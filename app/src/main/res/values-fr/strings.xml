    <string name="gateway_error_storage">Les identifiants de la passerelle n’ont pas pu être enregistrés ou chargés en toute sécurité. Recommencez l’association.</string>
    <string name="gateway_invalid_code">Saisissez le code valide fourni par la passerelle.</string>
    <string name="gateway_scan_qr">Scanner le code QR d’association</string>
