    <string name="gateway_paired">Passerelle associée</string>
    <string name="gateway_disconnected">Aucune passerelle associée</string>
    <string name="gateway_send">Envoyer le résumé de diagnostic</string>
    <string name="gateway_sending">Envoi en cours…</string>
    <string name="gateway_sent">Résumé de diagnostic livré</string>
    <string name="gateway_disconnect">Déconnecter la passerelle</string>
    <string name="gateway_privacy">Les rapports de diagnostic contiennent uniquement le nombre de SIM et le logement sélectionné, l’état du réseau, les versions de l’application et d’Android et la capacité du téléphone comme SIM. Les identifiants des SIM et les secrets d’authentification sont exclus des rapports. La session AKA distincte envoie des réponses d’authentification temporaires uniquement avec un consentement explicite.</string>
